# Copy to .env and fill in real values. Never commit real secrets.
AGENTGRID_APP_ENV=development
AGENTGRID_DATABASE_URL=sqlite+aiosqlite:///./agentgrid.db
# For Neon: postgresql+asyncpg://user:pass@host/db?sslmode=require

# Generate with:
# python -c "from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PrivateKey as K; from cryptography.hazmat.primitives import serialization as S; import base64; print(base64.urlsafe_b64encode(K.generate().private_bytes(S.Encoding.Raw, S.PrivateFormat.Raw, S.NoEncryption())).decode().rstrip('='))"
AGENTGRID_SIGNING_KEY_B64=
# Optional during rotation: old key still accepted for verification only.
# Generate with the same command above, using the previous private key.
AGENTGRID_PREVIOUS_SIGNING_KEY_B64=

AGENTGRID_ADMIN_KEY=
AGENTGRID_ADMIN_MFA_SECRET=
# Public registration is open self-service; no invitation token is required.
AGENTGRID_CORS_ORIGINS=
# Optional: automated three-step welcome email on registration.
# Choose ONE delivery mode. Keep all provider credentials in this file / Vercel
# env only; never commit real values.
#
# Mode 1: your own HTTPS webhook. AgentGrid POSTs
#         {to, client_id, type, subject, text, html} to this URL.
AGENTGRID_WELCOME_EMAIL_WEBHOOK_URL=
# Optional bearer token forwarded to that webhook.
AGENTGRID_WELCOME_EMAIL_WEBHOOK_TOKEN=
#
# Mode 2: Resend HTTPS API (used only if no webhook URL is set).
AGENTGRID_WELCOME_EMAIL_API_KEY=
AGENTGRID_WELCOME_FROM_EMAIL=
#
# Mode 3: SMTP, e.g. a Gmail app password (used only if 1 and 2 are unset).
AGENTGRID_WELCOME_EMAIL_SMTP_HOST=
AGENTGRID_WELCOME_EMAIL_SMTP_PORT=465
AGENTGRID_WELCOME_EMAIL_SMTP_USER=
AGENTGRID_WELCOME_EMAIL_SMTP_PASSWORD=
# Requests per minute per API key (or client IP when no key is supplied).
# Default 120. Set to 0 to disable (not recommended in production).
# On Postgres this uses a shared fixed-window counter table. SQLite uses a
# process-local counter for local development only.
AGENTGRID_RATE_LIMIT_PER_MIN=120
# Set to 1 for Lambda / multi-instance deployments after running `python migrate.py`.
# This prevents every cold start from running schema and trigger DDL.
AGENTGRID_SKIP_SCHEMA_ON_STARTUP=0
# Used by uvicorn/container deployments. Ignored by AWS Lambda.
PORT=8000

# Fixed hardening limits (not env-tunable):
# - 64 KB max request body, enforced from streamed bytes, not just Content-Length
# - 8 KB max handoff scope, no NaN/Infinity
# - 300s max handoff timestamp skew
# - agents, handoffs, audit_events, billing_history and overage_ledger are DB-immutable
# - billing cycles roll on signup day (Nov 18 -> Dec 18), never a calendar month
# - overage is metered only; base + overage are paid externally at cycle end
